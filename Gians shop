<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mockup Negozio Online</title>
  <style>
    /* Reset e stili base */
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: Arial, sans-serif; background: #f5f5f5; color: #333; }
    a { text-decoration: none; color: inherit; }

    /* Header */
    header { background: #fff; padding: 1rem 2rem; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
    .logo { font-size: 1.5rem; font-weight: bold; color: #6b3e26; }
    nav ul { list-style: none; display: flex; gap: 1rem; }

    /* Hero */
    .hero { background: #e2c38f; padding: 2rem; text-align: center; }
    .hero h1 { font-size: 2rem; color: #6b3e26; }

    /* Prodotti */
    .products { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px,1fr)); gap: 1rem; padding: 2rem; }
    .card { background: #fff; padding: 1rem; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
    .card img { width: 100%; border-radius: 4px; }
    .card h3 { margin: 0.5rem 0; font-size: 1.1rem; }
    .card p { font-size: 0.9rem; margin-bottom: 0.5rem; }
    .card .price { color: #b35400; font-weight: bold; }
    .card button { background: #b35400; color: #fff; border: none; padding: 0.5rem 1rem; cursor: pointer; border-radius: 4px; }

    /* Contatti */
    .contacts { background: #fff; margin: 2rem; padding: 2rem; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
    .contacts h2 { margin-bottom: 1rem; color: #6b3e26; }
    .contacts form { display: flex; flex-direction: column; gap: 0.5rem; }
    .contacts input, .contacts textarea { padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px; }
    .contacts button { width: fit-content; background: #6b3e26; color: #fff; border: none; padding: 0.5rem 1rem; cursor: pointer; border-radius: 4px; }

    /* Footer */
    footer { background: #fff; text-align: center; padding: 1rem; font-size: 0.8rem; }
  </style>
</head>
<body>
  <header>
    <div class="logo">Ritornelli Shop</div>
    <nav>
      <ul>
        <li><a href="#home">Home</a></li>
        <li><a href="#products">Prodotti</a></li>
        <li><a href="#contacts">Contatti</a></li>
      </ul>
    </nav>
  </header>

  <section id="home" class="hero">
    <h1>Benvenuti al Ritornelli Shop</h1>
    <p>I migliori biscotti artigianali per ogni momento della giornata.</p>
  </section>

  <section id="products" class="products">
    <!-- Card prodotto 1 -->
    <div class="card">
      <img src="https://via.placeholder.com/200x150" alt="Biscotti Classici">
      <h3>Biscotti Classici</h3>
      <p>Golosi e fragranti, perfetti con una tazza di tè.</p>
      <div class="price">€3,50</div>
      <button>Aggiungi al carrello</button>
    </div>
    <!-- Card prodotto 2 -->
    <div class="card">
      <img src="https://via.placeholder.com/200x150" alt="Biscotti Integrali">
      <h3>Biscotti Integrali</h3>
      <p>Con farina integrale e miele biologico.</p>
      <div class="price">€4,00</div>
      <button>Aggiungi al carrello</button>
    </div>
    <!-- Aggiungi altre card a piacere -->
  </section>

  <section id="contacts" class="contacts">
    <h2>Contattaci</h2>
    <form>
      <input type="text" placeholder="Nome">
      <input type="email" placeholder="Email (esempio@esempio.com)">
      <textarea rows="4" placeholder="Messaggio"></textarea>
      <button type="submit">Invia</button>
    </form>
    <p>Email: info@ritornellishop.example</p>
    <p>Telefono: +39 0123 456789</p>
  </section>

  <footer>
    &copy; 2025 Ritornelli Shop - Tutti i diritti riservati
  </footer>
</body>
</html>

